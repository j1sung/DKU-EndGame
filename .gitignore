# Build output
Binaries/
DerivedDataCache/
Intermediate/
Saved/

# Unreal project user settings
.vsconfig

# Unreal Editor user-specific settings
*.user
*.userprefs

# =========================================================
# Visual Studio
# =========================================================

.vs/
.vscode/

# Visual Studio user-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio database / cache
*.VC.db
*.VC.VC.opendb
*.opensdf
*.sdf

# Engine-generated IDE projects
*.sln
*.slnx
*.xcodeproj
*.xcworkspace
# =========================================================
# Build / temporary files
# =========================================================

# Keep packaging icons and blacklist files available for tracking
/Build/*
!/Build/*/
/Build/*/**
!/Build/*/PakBlacklist*.txt
!/Build/**/*.ico
[Dd]ebug/
[Rr]elease/
x64/
x86/

*.log
*.tmp
*.temp

# Compiled objects and precompiled headers
*.slo
*.lo
*.o
*.obj
*.gch
*.pch

# Plugin-generated output (keep authored/prebuilt plugin dependencies)
Plugins/**/Binaries/
Plugins/**/Intermediate/

# =========================================================
# OS
# =========================================================

.DS_Store
Thumbs.db
Desktop.ini

# =========================================================
# Backend TypeScript build output
# =========================================================

Backend-Infra/backend/node_modules/
Backend-Infra/backend/dist/
Backend-Infra/backend/coverage/
Backend-Infra/vendor/eos-sdk/*
!Backend-Infra/vendor/eos-sdk/README.md
Backend-Infra/backend/native/build/
Backend-Infra/.aws-sam/
Backend-Infra/.sam-local/
Backend-Infra/.env*
Backend-Infra/backend/.env*

# Machine-local EOS game-client credentials (selected with -CustomConfig=EOSLocal)
/Config/Custom/EOSLocal/

# =========================================================
# Unreal generated files
# =========================================================

*_BuiltData.uasset
